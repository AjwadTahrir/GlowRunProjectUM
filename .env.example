# Copy to server/.env and fill in. Never commit the filled version.

NODE_ENV=development
PORT=4000
TRUST_PROXY=0
PUBLIC_WEB_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/witches_glow_run
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/witches_glow_run_test

# --- Capacity policy --------------------------------------------------------
MAX_CAPACITY=500
CAPACITY_COUNTS_PENDING_PAYMENT=true

# --- Secrets ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
UPLOAD_SIGNING_SECRET=5c2da33b668b7217c1e3eefb8a4085c09a05aac16ea8ab0801c90efc1f8571ee
ADMIN_API_TOKEN=0fcdee180384af89a4d36180d43e83545c6cb5d8bcb987a09f1063ed2172f512

# --- File storage -----------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=./.private-uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,application/pdf

# Only when STORAGE_DRIVER=s3. Bucket must block all public access.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Google Sheets ----------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Registrations
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the key with literal \n escapes, wrapped in double quotes.
GOOGLE_PRIVATE_KEY=
# Alternative to the two vars above:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Terms ------------------------------------------------------------------
TERMS_VERSION=PLACEHOLDER-v0
